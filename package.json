{
  "name": "@you1anna/aegean",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Human-governed agentic software delivery",
  "engines": { "node": "26.12.1" },
  "bin": { "aegean": "dist/src/cli.js" },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test:quick": "npm run build && node --test --test-concurrency=1 --test-timeout=10000 dist/test/workflow.test.js",
    "test": "npm run build && node --test --test-concurrency=1 --test-timeout=300000 dist/test/*.test.js && node --test test/*.test.mjs",
    "start": "node dist/src/cli.js"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": { "@types/node": "26.6.6", "typescript": "7.0.2" }
}
