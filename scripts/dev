#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "${1:-help}" in
  help|--help|-h)
    echo 'Usage: ./scripts/dev setup|build|check|test'
    echo 'setup: pinned runtime and locked dependencies; build: clean compile; check: types and scripts; test: clean build and synthetic tests'
    echo 'Requires mise. No task installs Aegean, starts a VM or calls models.'
    exit 0 ;;
  setup|build|check|test) ;;
  *) echo "Unknown task: $1. Run ./scripts/dev help" >&2; exit 2 ;;
esac
[ "$#" -eq 1 ] || { echo 'Tasks take no extra arguments' >&2; exit 2; }
command -v mise >/dev/null 2>&1 || { echo 'mise is required. Install it using https://mise.jdx.dev/getting-started.html' >&2; exit 1; }
cd "$repo"
[ ! -L .aegean ] || { echo 'Refusing symlink task state' >&2; exit 1; }
mkdir -p .aegean
locked() {
  lock="$repo/.aegean/$1"; owner=$2
  case "$owner" in ''|*[!0-9]*) owner= ;; esac
  if [ -n "$owner" ] && ps -p "$owner" >/dev/null 2>&1; then
    echo "Source commands locked: process $owner still runs ($(ps -p "$owner" -o command= 2>/dev/null))." >&2
    echo 'Wait for it to finish, or stop it, then run this command again.' >&2
  else
    if [ -n "$owner" ]; then
      echo "Source commands locked by process $owner, which no longer runs. An earlier command was interrupted." >&2
    else
      echo "Source commands locked, but $lock records no owner process. Investigate before removal." >&2
    fi
    echo 'If no other Aegean source command runs (check: pgrep -fl "scripts/dev|dev-tasks"), remove the lock and run this command again:' >&2
    echo "  rm -r \"$lock\"" >&2
  fi
  exit 1
}
[ ! -e .aegean/source-task ] || locked source-task "$(sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' .aegean/source-task/owner.json 2>/dev/null)"
mkdir .aegean/source-launcher 2>/dev/null || locked source-launcher "$(cat .aegean/source-launcher/owner 2>/dev/null)"
printf '%s\n' "$$" > .aegean/source-launcher/owner
interrupted() {
  trap - EXIT
  echo "$1. The lock $repo/.aegean/source-launcher stays in place." >&2
  echo "When no Aegean source command runs, remove it with: rm -r \"$repo/.aegean/source-launcher\"" >&2
  exit "$2"
}
trap 'rm -f .aegean/source-launcher/owner; rmdir .aegean/source-launcher' EXIT
trap 'interrupted Interrupted 130' INT
trap 'interrupted Terminated 143' TERM
if [ "$1" = setup ]; then
  mise trust "$repo/mise.toml"
  mise install
fi
MISE_AUTO_INSTALL=0 mise exec -- node "$repo/scripts/dev-tasks.mjs" "$1"
